    <delete id="deleteImageStoreById" parameterType="Long">
        delete from image_store where image_id = #{imageId}
    </delete>

    <delete id="deleteImageStoreByIds" parameterType="Long[]">
        delete from image_store where image_id in
        <foreach item="imageId" collection="array" open="(" separator="," close=")">
            #{imageId}
        </foreach>
    </delete>
</mapper>