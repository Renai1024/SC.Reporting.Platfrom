<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miracle.extra.mapper.ImageStoreMapper">

    <resultMap type="com.miracle.extra.domain.ImageStore" id="ImageStoreResult">
        <id property="imageId" column="image_id"/>
        <result property="imageName" column="image_name"/>
        <result property="originalName" column="original_name"/>
        <result property="imagePath" column="image_path"/>
        <result property="imageUrl" column="image_url"/>
        <result property="imageSize" column="image_size"/>
        <result property="imageType" column="image_type"/>
        <result property="bucketName" column="bucket_name"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectImageStoreVo">
        select image_id, image_name, original_name, image_path, image_url, image_size, image_type, bucket_name, status, remark, create_by, create_time, update_by, update_time
        from image_store
    </sql>

    <select id="selectImageStoreList" parameterType="com.miracle.extra.domain.ImageStore" resultMap="ImageStoreResult">
        <include refid="selectImageStoreVo"/>
        <where>
            <if test="imageName != null and imageName != ''">
                and image_name like concat('%', #{imageName}, '%')
            </if>
            <if test="originalName != null and originalName != ''">
                and original_name like concat('%', #{originalName}, '%')
            </if>
            <if test="imageType != null and imageType != ''">
                and image_type = #{imageType}
            </if>
            <if test="bucketName != null and bucketName != ''">
                and bucket_name = #{bucketName}
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectImageStoreById" parameterType="Long" resultMap="ImageStoreResult">
        <include refid="selectImageStoreVo"/>
        where image_id = #{imageId}
    </select>

    <select id="selectImageStoreByPath" parameterType="String" resultMap="ImageStoreResult">
        <include refid="selectImageStoreVo"/>
        where image_path = #{imagePath}
    </select>

    <insert id="insertImageStore" parameterType="com.miracle.extra.domain.ImageStore" useGeneratedKeys="true" keyProperty="imageId">
        insert into image_store
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="imageName != null and imageName != ''">image_name,</if>
            <if test="originalName != null and originalName != ''">original_name,</if>
            <if test="imagePath != null and imagePath != ''">image_path,</if>
            <if test="imageUrl != null and imageUrl != ''">image_url,</if>
            <if test="imageSize != null">image_size,</if>
            <if test="imageType != null and imageType != ''">image_type,</if>
            <if test="bucketName != null and bucketName != ''">bucket_name,</if>
            <if test="status != null">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="imageName != null and imageName != ''">#{imageName},</if>
            <if test="originalName != null and originalName != ''">#{originalName},</if>
            <if test="imagePath != null and imagePath != ''">#{imagePath},</if>
            <if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
            <if test="imageSize != null">#{imageSize},</if>
            <if test="imageType != null and imageType != ''">#{imageType},</if>
            <if test="bucketName != null and bucketName != ''">#{bucketName},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateImageStore" parameterType="com.miracle.extra.domain.ImageStore">
        update image_store
        <set>
            <if test="imageName != null and imageName != ''">image_name = #{imageName},</if>
            <if test="originalName != null and originalName != ''">original_name = #{originalName},</if>
            <if test="imagePath != null and imagePath != ''">image_path = #{imagePath},</if>
            <if test="imageUrl != null and imageUrl != ''">image_url = #{imageUrl},</if>
            <if test="imageSize != null">image_size = #{imageSize},</if>
            <if test="imageType != null and imageType != ''">image_type = #{imageType},</if>
            <if test="bucketName != null and bucketName != ''">bucket_name = #{bucketName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where image_id = #{imageId}
    </update>

